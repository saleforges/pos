api.saleforges.local {
    tls internal
    @iam path /v1/auth/* /v1/users/* /v1/roles/* /v1/permissions/*
    handle @iam {
        rewrite * /api{path}
        reverse_proxy localhost:{env.IAM_PORT}
    }

    @merchant path /v1/merchants/* /v1/branches/*
    handle @merchant {
        rewrite * /api{path}
        reverse_proxy localhost:{env.MERCHANT_PORT}
    }

    @catalog path /v1/catalog/*
    handle @catalog {
        rewrite * /api{path}
        reverse_proxy localhost:{env.CATALOG_PORT}
    }
}
