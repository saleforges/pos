localhost {
    @iam path /api/v1/auth/* /api/v1/users/* /api/v1/roles/* /api/v1/permissions/*
    handle @iam {
        reverse_proxy localhost:{env.IAM_PORT}
    }

    @merchant path /api/v1/merchants/* /api/v1/branches/*
    handle @merchant {
        reverse_proxy localhost:{env.MERCHANT_PORT}
    }

    @catalog path /api/v1/catalog/*
    handle @catalog {
        reverse_proxy localhost:{env.CATALOG_PORT}
    }

    @sales path /api/v1/sales/*
    handle @sales {
        reverse_proxy localhost:{env.SALES_PORT}
    }

    @inventory path /api/v1/stocks* /api/v1/product-items*
    handle @inventory {
        reverse_proxy localhost:{env.INVENTORY_PORT}
    }

    @order path /api/v1/orders* /api/v1/customers*
    handle @order {
        reverse_proxy localhost:{env.ORDER_PORT}
    }

    @backoffice path /*
    handle @backoffice {
        reverse_proxy localhost:5173
    }
}

