meta {
  name: Register
  method: POST
  url: {{base_url}}/api/v1/auth/register
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{username}}",
    "email": "{{email}}",
    "password": "{{password}}",
    "roles": ["viewer"]
  }
}

script.post-response {
  if (res.status === 201) {
    bru.setVar("access_token", res.body.access_token);
    bru.setVar("refresh_token", res.body.refresh_token);
  }
}
