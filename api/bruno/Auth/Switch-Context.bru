meta {
  name: Switch Context
  type: http
  seq: 7
}

post {
  url: {{base_url}}/v1/auth/switch-context
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "userRoleId": {{role_id}}
  }
}

vars:pre-request {
  role_id: 6
}

script:post-response {
  if (res.body.data) {
    bru.setVar("access_token", res.body.data.accessToken);
  }
}
