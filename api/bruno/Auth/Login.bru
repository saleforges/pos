meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{base_url}}/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

  body:json {
  {
    "username": "{{owner_user}}",
    "password": "{{owner_pass}}"
  }
}

script:post-response {
  if (res.body.data) {
    bru.setVar("access_token", res.body.data.access_token);
    bru.setVar("refresh_token", res.body.data.refresh_token);
  }
}

