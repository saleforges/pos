meta {
  name: Product Bulk Update
  type: http
  seq: 6
}

patch {
  url: {{base_url}}/v1/products/bulk/{{product_id}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Merchant-Id: {{merchant_id}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "Marning Updated",
    "description": "Deskripsi baru",
    "items": [
      {"name": "Marning Curah", "unitId": 3, "price": 18000, "trackInventory": true},
      {"name": "Marning Pack", "unitId": 2, "price": 25000, "trackInventory": true}
    ]
  }
}
