meta {
  name: Category Create
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/categories
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Merchant-Id: {{merchant_id}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "Minuman",
    "slug": "minuman",
    "description": "Semua jenis minuman",
    "sort_order": 1
  }
}

script:post-response {
  if (res.body.data && res.body.data.id) {
    bru.setVar("catalog_id", res.body.data.id);
  }
}
