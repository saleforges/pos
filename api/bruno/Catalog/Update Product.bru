meta {
  name: Update Product
  type: http
  seq: 9
}

put {
  url: {{catalog_base_url}}/api/v1/merchants/{{merchant_id}}/products/{{product_id}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "name": "Nasi Goreng Spesial",
    "price": 30000,
    "unit": "porsi"
  }
}
