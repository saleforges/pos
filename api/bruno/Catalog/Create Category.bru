meta {
  name: Create Category
  type: http
  seq: 1
}

post {
  url: {{catalog_base_url}}/api/v1/merchants/{{merchant_id}}/categories
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "name": "Makanan",
    "slug": "makanan",
    "description": "Kategori makanan",
    "sort_order": 1
  }
}

script:post-response {
  if (res.body.id) {
    bru.setVar("catalog_id", res.body.id);
  }
}
