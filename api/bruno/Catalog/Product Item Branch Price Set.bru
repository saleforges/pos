meta {
  name: Product Item Branch Price Set
  type: http
  seq: 9
}

put {
  url: {{base_url}}/v1/product-items/{{item_id}}/branch-price
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Merchant-Id: {{merchant_id}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "branchId": {{branch_id}},
    "amount": 20000,
    "currency": "IDR"
  }
}
