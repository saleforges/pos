meta {
  name: Product Create
  type: http
  seq: 6
}

post {
  url: {{base_url}}/v1/products
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Merchant-Id: {{merchant_id}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "categoryId": {{catalog_id}},
    "name": "Es Teh Manis",
    "description": "Teh manis dengan es batu"
  }
}

script:post-response {
  if (res.body.data && res.body.data.id) {
    bru.setVar("product_id", res.body.data.id);
  }
}
