meta {
  name: Update Variant
  type: http
  seq: 13
}

put {
  url: {{catalog_base_url}}/api/v1/merchants/{{merchant_id}}/variants/{{variant_id}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "name": "Reguler",
    "price": 27000,
    "sort_order": 1
  }
}
