meta {
  name: Variant Update
  type: http
  seq: 13
}

put {
  url: {{base_url}}/v1/products/variants/{{variant_id}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Merchant-Id: {{merchant_id}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "price": 7500,
    "name": "Es Teh Manis - Large"
  }
}
