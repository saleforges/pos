meta {
  name: Create Product
  type: http
  seq: 6
}

post {
  url: {{catalog_base_url}}/api/v1/merchants/{{merchant_id}}/products
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "category_id": "{{catalog_id}}",
    "name": "Nasi Goreng",
    "sku": "NG-001",
    "barcode": "",
    "description": "Nasi goreng spesial",
    "price": 25000,
    "cost": 15000,
    "tax_rate": 0,
    "unit": "porsi",
    "image_url": ""
  }
}

script:post-response {
  if (res.body.id) {
    bru.setVar("product_id", res.body.id);
  }
}
