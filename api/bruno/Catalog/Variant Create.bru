meta {
  name: Variant Create
  type: http
  seq: 11
}

post {
  url: {{catalog_base_url}}/v1/merchants/{{merchant_id}}/products/{{product_id}}/variants
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
