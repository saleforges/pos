meta {
  name: Product Item Update
  type: http
  seq: 13
}

patch {
  url: {{base_url}}/v1/product-items/{{item_id}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Merchant-Id: {{merchant_id}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "Updated Item Name",
    "sku": "NEW-SKU-001",
    "price": 18000,
    "trackInventory": false
  }
}
