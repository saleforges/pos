meta {
  name: Product Update
  type: http
  seq: 9
}

put {
  url: {{base_url}}/v1/products/{{product_id}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Merchant-Id: {{merchant_id}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "price": 5500,
    "description": "Teh manis dengan es batu segar"
  }
}
