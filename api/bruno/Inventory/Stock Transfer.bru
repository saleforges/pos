meta {
  name: Stock Transfer
  type: http
  seq: 8
}

post {
  url: {{base_url}}/v1/stocks/transfer
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Merchant-Id: {{merchant_id}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "fromBranchId": 1,
    "toBranchId": {{branch_id}},
    "items": [
      {
        "productItemId": {{item_id}},
        "quantity": 10
      }
    ]
  }
}
