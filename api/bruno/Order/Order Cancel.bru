meta {
  name: Order Cancel
  type: http
  seq: 10
}

patch {
  url: {{base_url}}/v1/orders/{{order_id}}/status
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Merchant-Id: {{merchant_id}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "status": "cancelled"
  }
}
