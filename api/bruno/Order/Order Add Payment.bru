meta {
  name: Order Add Payment
  type: http
  seq: 9
}

post {
  url: {{base_url}}/v1/orders/{{order_id}}/payments
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Merchant-Id: {{merchant_id}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "amount": 20000,
    "method": "cash"
  }
}
