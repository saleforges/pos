meta {
  name: Customer Create
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/customers
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Merchant-Id: {{merchant_id}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "Pak Budi",
    "phone": "081234567890",
    "address": "Jl. Contoh No. 45"
  }
}

script:post-response {
  if (res.body.data && res.body.data.id) {
    bru.setVar("customer_id", res.body.data.id);
  }
}
