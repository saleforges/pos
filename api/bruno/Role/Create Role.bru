meta {
  name: Create Role
  method: POST
  url: {{base_url}}/api/v1/roles
  body: json
}

headers {
  Content-Type: application/json
}

auth {
  type: bearer
  token: {{access_token}}
}

body:json {
  {
    "name": "manager",
    "description": "Store manager role",
    "permissions": [
      "catalog.read",
      "catalog.write",
      "inventory.read",
      "inventory.write",
      "sales.read",
      "user.list",
      "user.read"
    ]
  }
}
