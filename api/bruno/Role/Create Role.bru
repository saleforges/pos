meta {
  name: Create Role
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/roles
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "manager",
    "description": "Store manager role",
    "permissions": [
      "catalog.read",
      "catalog.write",
      "inventory.read",
      "inventory.write",
      "sales.read",
      "user.list",
      "user.read"
    ]
  }
}
