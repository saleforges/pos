meta {
  name: Internal Stock Deduct
  type: http
  seq: 3
}

post {
  url: {{base_url}}/internal/stocks/deduct
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Internal-Key: {{internal_key}}
  X-Merchant-Id: {{merchant_id}}
}

body:json {
  {
    "branchId": {{branch_id}},
    "referenceType": "order",
    "referenceId": {{order_id}},
    "items": [
      {
        "productItemId": {{item_id}},
        "quantity": 1
      }
    ]
  }
}
