# Log level (debug, info, warn, error). Leave empty to default to info.
LOG_LEVEL=info

# Log format (text, json). Leave empty to default to text.
LOG_FORMAT=text

# HTTP server bind address
HTTP_ADDR=:8080

# JWT key identifier published in JWKS
JWT_KEY_ID=iam-key-1

# Comma-separated list of allowed CORS origins. Leave empty to allow none.
# Example: http://localhost:3000,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# RSA private key used to sign JWTs.
# REQUIRED — the application will fail to start if this is empty.
JWT_PRIVATE_KEY_PEM=

# PostgreSQL connection string.
# Leave empty to use in-memory storage.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pos_iam?sslmode=disable

# Redis address for distributed cache and session storage.
# Leave empty to use in-memory stores (single-instance only).
REDIS_ADDR=localhost:6379

# OpenTelemetry endpoint for traces (OTLP gRPC).
# Leave empty to default to localhost:4317 (Tempo).
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Set to false to disable Secure flag on auth cookies (e.g. local dev without TLS).
# Defaults to true if unset.
SECURE_COOKIES=true

# Secret key used to hash refresh tokens for storage.
# This is not a signing key, but it MUST be a non-empty secret.
# REQUIRED — the application will fail to start if this is empty.
TOKEN_HASHER_SECRET=change-me-to-a-random-secret
