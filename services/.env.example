# HTTP server bind address
HTTP_ADDR=:8080

# JWT key identifier published in JWKS
JWT_KEY_ID=iam-key-1

# RSA private key used to sign JWTs.
# REQUIRED — the application will fail to start if this is empty.
JWT_PRIVATE_KEY_PEM=

# PostgreSQL connection string.
# Leave empty to use in-memory storage.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pos_iam?sslmode=disable

# OpenTelemetry endpoint for traces (OTLP gRPC).
# Leave empty to default to localhost:4317 (Tempo).
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Set to false to disable Secure flag on auth cookies (e.g. local dev without TLS).
# Defaults to true if unset.
SECURE_COOKIES=true
